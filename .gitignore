# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Firebase Admin SDK service account keys (uploaded to EAS, never committed).
# google-services.json is NOT this — that one is a client config, safe to commit.
*firebase-adminsdk*.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# ...except the prod Convex URL override: it must outrank the dev URL that
# `npx convex dev` writes into .env.local, and it holds only public EXPO_PUBLIC_
# values, so it is committed and shared across build machines.
!.env.production.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
